# ---------------------------------------------------------------------------
# Dependências e builds
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
*.tsbuildinfo
.vite/

# Rust / Tauri (também coberto por src-tauri/.gitignore)
src-tauri/target/
src-tauri/gen/schemas/
**/*.rs.bk

# Instaladores gerados fora do target
*.msi
*.exe
!src-tauri/icons/**

# ---------------------------------------------------------------------------
# Logs e temporários
# ---------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.json.tmp
coverage/

# Arquivos temporários do próprio app (escritas atômicas)
.*.save-nuvem-*

# ---------------------------------------------------------------------------
# Segurança: credenciais e dados pessoais nunca devem subir
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Dados do app (ficam em %APPDATA%\com.savenuvem.app, mas por garantia)
config.json
sync-state.json
activity.json
backups/

# Saves de emuladores (memory cards e save states) usados em testes manuais
*.ps2
*.mcd
*.mcr
memcards/
sstates/

# ---------------------------------------------------------------------------
# Editores, IDEs e sistema
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# Configurações locais de agentes/assistentes
.claude/settings.local.json
